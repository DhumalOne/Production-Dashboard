# Copy to .env.local for development. In production set these in Vercel → Settings → Environment Variables.

# Database (Supabase, Mumbai). Use the transaction pooler URL in production.
# dash_web_login    : member of dash_web, SELECT on rpt only
# dash_ingest_login : member of dash_ingest, may only call raw.ingest()
DATABASE_URL_WEB=postgresql://dash_web_login:CHANGE_ME@127.0.0.1:55422/postgres
DATABASE_URL_INGEST=postgresql://dash_ingest_login:CHANGE_ME@127.0.0.1:55422/postgres

# Office agent API keys (comma-separated, each at least 32 characters; two allow rotation)
INGEST_API_KEYS=

# Supabase Auth (email OTP)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only these addresses may sign in (comma-separated)
ALLOWED_EMAILS=
